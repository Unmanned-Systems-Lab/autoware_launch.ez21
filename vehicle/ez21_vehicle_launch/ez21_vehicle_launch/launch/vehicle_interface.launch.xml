<?xml version="1.0" encoding="UTF-8"?>
<launch>
  <arg name="vehicle_id" default="$(env VEHICLE_ID default)"/>
  <arg
    name="config_file"
    default="$(find-pkg-share ez21_vehicle_launch)/config/vehicle_interface.param.yaml"/>

  <node
    pkg="ez21_vehicle_launch"
    exec="ez21_vehicle_interface_node"
    name="ez21_vehicle_interface"
    output="screen">
    <param from="$(var config_file)"/>
    <param name="vehicle_id" value="$(var vehicle_id)"/>

    <remap from="input/control_cmd" to="/control/command/control_cmd"/>
    <remap from="input/actuation_cmd" to="/control/command/actuation_cmd"/>
    <remap from="input/gear_cmd" to="/control/command/gear_cmd"/>
    <remap from="input/turn_indicators_cmd" to="/control/command/turn_indicators_cmd"/>
    <remap from="input/hazard_lights_cmd" to="/control/command/hazard_lights_cmd"/>
    <remap from="input/control_mode_request" to="/control/control_mode_request"/>
  </node>
</launch>
