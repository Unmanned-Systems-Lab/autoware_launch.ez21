<?xml version="1.0" encoding="UTF-8"?>
<launch>
  <!-- Essential parameters -->
  <arg name="map_path" default="/media/nvidia/program/autoware.ez21/src/launcher/autoware_launch_ez21/ui/generated_maps/autoware_init_map" description="point cloud and lanelet2 map directory path"/>
  <arg name="vehicle_model" default="ez21_vehicle" description="vehicle model name"/>
  <arg name="sensor_model" default="ez21_sensor_kit" description="sensor model name used for vehicle/sensor TFs"/>
  <arg name="data_path" default="$(env HOME)/autoware_data" description="packages data and artifacts directory path"/>
  <arg name="pointcloud_container_name" default="pointcloud_container" description="pointcloud container name"/>
  <arg
    name="vehicle_param_file"
    default="$(find-pkg-share $(var vehicle_model)_description)/config/vehicle_info.param.yaml"
    description="vehicle info parameter file used by the M1 pointcloud preprocessor"
  />

  <!-- launch module preset -->
  <arg name="planning_module_preset" default="default" description="planning module preset"/>
  <arg name="control_module_preset" default="real_vehicle_minimal" description="control module preset"/>
  <arg
    name="diagnostic_graph_aggregator_graph_path"
    default="$(find-pkg-share autoware_launch)/config/system/diagnostics/autoware-real-vehicle-minimal.yaml"
    description="diagnostic graph config"
  />
  <arg
    name="component_state_monitor_topic_path"
    default="$(find-pkg-share autoware_launch)/config/system/component_state_monitor/topics-real-vehicle-robosense-m1.yaml"
    description="component state monitor topics for this launch"
  />
  <arg
    name="operation_mode_transition_manager_param_path"
    default="$(find-pkg-share autoware_launch)/config/control/operation_mode_transition_manager/operation_mode_transition_manager.real_vehicle_minimal.param.yaml"
    description="operation mode transition manager params for this launch"
  />

  <!-- Vehicle / localization -->
  <arg name="vehicle_id" default="$(env VEHICLE_ID default)" description="vehicle specific ID"/>
  <arg name="ins_driver_can_interface" default="can0" description="SocketCAN interface used by the INS driver"/>

  <!-- Perception -->
  <arg name="perception_mode" default="lidar" description="perception mode"/>
  <arg name="use_traffic_light_recognition" default="false" description="disable traffic light recognition for lidar-only perception"/>
  <arg
    name="robosense_m1_config_path"
    default="$(find-pkg-share autoware_launch)/config/sensing/robosense_m1.param.yaml"
    description="Robosense M1 driver config"
  />
  <arg
    name="m1_ground_segmentation_param_path"
    default="$(find-pkg-share autoware_launch)/config/perception/obstacle_segmentation/ground_segmentation/ground_segmentation.robosense_m1.param.yaml"
    description="ground segmentation params tuned for Robosense M1"
  />
  <arg
    name="use_cuda_ground_segmentation"
    default="false"
    description="use CUDA ground segmentation for the Robosense M1 lidar pipeline"
  />
  <arg
    name="m1_voxel_grid_based_euclidean_cluster_param_path"
    default="$(find-pkg-share autoware_launch)/config/perception/object_recognition/detection/clustering/voxel_grid_based_euclidean_cluster.robosense_m1.param.yaml"
    description="voxel-grid clustering params tuned for Robosense M1"
  />

  <!-- Tools -->
  <arg name="rviz" default="true" description="launch rviz"/>
  <arg name="rviz_config_name" default="autoware_robosense_m1.rviz" description="rviz config for the M1 launch"/>
  <arg name="launch_ui" default="false" description="launch runtime route/HMI UI server"/>

  <include file="$(find-pkg-share autoware_launch)/launch/autoware.launch.xml">
    <!-- Common -->
    <arg name="map_path" value="$(var map_path)"/>
    <arg name="vehicle_model" value="$(var vehicle_model)"/>
    <arg name="sensor_model" value="$(var sensor_model)"/>
    <arg name="data_path" value="$(var data_path)"/>
    <arg name="pointcloud_container_name" value="$(var pointcloud_container_name)"/>
    <arg name="planning_module_preset" value="$(var planning_module_preset)"/>
    <arg name="control_module_preset" value="$(var control_module_preset)"/>
    <arg name="vehicle_id" value="$(var vehicle_id)"/>
    <arg name="perception_mode" value="$(var perception_mode)"/>

    <!-- Keep the real-vehicle planning/control stack, but use a custom single-lidar sensing + perception path -->
    <arg name="launch_pointcloud_container" value="true"/>
    <arg name="launch_vehicle" value="true"/>
    <arg name="launch_vehicle_interface" value="true"/>
    <arg name="launch_system" value="true"/>
    <arg name="launch_system_monitor" value="false"/>
    <arg name="diagnostic_graph_aggregator_graph_path" value="$(var diagnostic_graph_aggregator_graph_path)"/>
    <arg name="component_state_monitor_topic_path" value="$(var component_state_monitor_topic_path)"/>
    <arg name="launch_map" value="true"/>
    <arg name="launch_sensing" value="false"/>
    <arg name="launch_localization" value="true"/>
    <arg name="launch_ins_driver" value="true"/>
    <arg name="ins_driver_can_interface" value="$(var ins_driver_can_interface)"/>
    <arg name="launch_perception" value="false"/>
    <arg name="launch_planning_dummy_publishers" value="false"/>
    <arg name="launch_planning" value="true"/>
    <arg name="launch_control" value="true"/>
    <arg name="operation_mode_transition_manager_param_path" value="$(var operation_mode_transition_manager_param_path)"/>
    <arg name="launch_api" value="true"/>

    <!-- Real-vehicle defaults -->
    <arg name="system_run_mode" value="online"/>
    <arg name="use_sim_time" value="false"/>
    <arg name="is_simulation" value="false"/>
    <arg name="launch_dummy_diag_publisher" value="false"/>

    <!-- Tools -->
    <arg name="rviz" value="$(var rviz)"/>
    <arg name="rviz_config_name" value="$(var rviz_config_name)"/>
    <arg name="launch_ui" value="$(var launch_ui)"/>
  </include>

  <!-- Robosense M1 driver -->
  <node pkg="rslidar_sdk" exec="rslidar_sdk_node" output="screen">
    <param name="config_path" value="$(var robosense_m1_config_path)"/>
  </node>

  <!-- The M1 driver is configured to publish an Autoware-compatible pointcloud layout.
       Keep preprocessing minimal: remove ego-vehicle returns, then feed the filtered cloud
       to localization/perception. -->
  <include file="$(find-pkg-share autoware_launch)/launch/components/robosense_m1_pointcloud_preprocessor.launch.py">
    <arg name="pointcloud_container_name" value="$(var pointcloud_container_name)"/>
    <arg name="vehicle_param_file" value="$(var vehicle_param_file)"/>
    <arg name="input_frame" value="base_link"/>
    <arg name="output_frame" value="base_link"/>
    <arg name="input_pointcloud" value="/sensing/lidar/top/pointcloud_raw_ex"/>
    <arg name="output_pointcloud" value="/sensing/lidar/concatenated/pointcloud"/>
    <arg name="use_intra_process" value="true"/>
  </include>

  <!-- Lidar-only perception tuned for the single-front M1 setup. -->
  <include file="$(find-pkg-share autoware_launch)/launch/components/tier4_perception_component.launch.xml">
    <arg name="use_sim_time" value="false"/>
    <arg name="vehicle_model" value="$(var vehicle_model)"/>
    <arg name="data_path" value="$(var data_path)"/>
    <arg name="pointcloud_container_name" value="$(var pointcloud_container_name)"/>
    <arg name="launch_pointcloud_container" value="false"/>
    <arg name="use_empty_dynamic_object_publisher" value="true"/>
    <arg name="use_traffic_light_recognition" value="$(var use_traffic_light_recognition)"/>
    <arg name="lidar_detection_model" value="centerpoint/centerpoint_tiny"/>
    <arg name="use_multi_channel_tracker_merger" value="false"/>
    <arg name="use_obstacle_segmentation_time_series_filter" value="false"/>
    <arg name="use_cuda_ground_segmentation" value="$(var use_cuda_ground_segmentation)"/>
    <arg name="obstacle_segmentation_ground_segmentation_param_path" value="$(var m1_ground_segmentation_param_path)"/>
    <arg name="object_recognition_detection_voxel_grid_based_euclidean_cluster_param_path" value="$(var m1_voxel_grid_based_euclidean_cluster_param_path)"/>
  </include>
</launch>
