<?xml version="1.0" encoding="UTF-8"?>
<launch>
  <arg name="map_path" default="$(find-pkg-share autoware_launch)/../../../../src/launcher/autoware_launch/ui/generated_maps/autoware_init_map" description="point cloud and lanelet2 map directory path"/>
  <arg name="vehicle_model" default="scout_vehicle" description="vehicle model name"/>
  <arg name="sensor_model" default="scout_sensor_kit" description="sensor model name"/>
  <arg name="data_path" default="$(env HOME)/autoware_data" description="packages data and artifacts directory path"/>

  <arg name="planning_module_preset" default="default" description="planning module preset"/>
  <arg name="control_module_preset" default="default" description="control module preset"/>

  <arg name="lanelet2_map_file" default="lanelet2_map.osm" description="lanelet2 map file name"/>
  <arg name="pointcloud_map_file" default="pointcloud_map.pcd" description="pointcloud map file name"/>
  <arg name="rviz" default="true" description="launch rviz"/>
  <arg name="rviz_config_name" default="autoware.rviz" description="rviz config name"/>
  <arg name="launch_system" default="true" description="launch system diagnostics and emergency handling"/>
  <arg name="launch_dummy_diag_publisher" default="true" description="launch dummy diagnostic publisher"/>
  <arg name="vehicle_simulation" default="true" description="use vehicle simulation"/>
  <arg name="scenario_simulation" default="false" description="use scenario simulation"/>
  <arg name="use_sim_time" default="$(var scenario_simulation)" description="use simulated time"/>
  <arg name="localization_sim_mode" default="api" description="localization simulation mode"/>
  <arg name="launch_ins_driver" default="true" description="launch INS driver for localization input"/>
  <arg name="launch_planning_dummy_publishers" default="false" description="launch planning dummy publishers"/>
  <arg name="launch_freespace_bypass_coordinator" default="true" description="launch freespace bypass coordinator"/>

  <include file="$(find-pkg-share autoware_launch)/launch/planning_simulator.launch.xml">
    <arg name="map_path" value="$(var map_path)"/>
    <arg name="vehicle_model" value="$(var vehicle_model)"/>
    <arg name="sensor_model" value="$(var sensor_model)"/>
    <arg name="data_path" value="$(var data_path)"/>
    <arg name="planning_module_preset" value="$(var planning_module_preset)"/>
    <arg name="control_module_preset" value="$(var control_module_preset)"/>
    <arg name="lanelet2_map_file" value="$(var lanelet2_map_file)"/>
    <arg name="pointcloud_map_file" value="$(var pointcloud_map_file)"/>
    <arg name="rviz" value="$(var rviz)"/>
    <arg name="rviz_config_name" value="$(var rviz_config_name)"/>
    <arg name="launch_system" value="$(var launch_system)"/>
    <arg name="launch_dummy_diag_publisher" value="$(var launch_dummy_diag_publisher)"/>
    <arg name="vehicle_simulation" value="$(var vehicle_simulation)"/>
    <arg name="scenario_simulation" value="$(var scenario_simulation)"/>
    <arg name="use_sim_time" value="$(var use_sim_time)"/>
    <arg name="localization_sim_mode" value="$(var localization_sim_mode)"/>
    <arg name="launch_ins_driver" value="$(var launch_ins_driver)"/>
    <arg name="launch_planning_dummy_publishers" value="$(var launch_planning_dummy_publishers)"/>
    <arg name="launch_freespace_bypass_coordinator" value="$(var launch_freespace_bypass_coordinator)"/>
  </include>
</launch>
